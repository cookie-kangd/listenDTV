<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- frosted glass: translucent dark base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#991B1B20" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>

    <!-- light sheen fading towards the bottom for a glass feel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#05FFFFFF" />
        </shape>
    </item>

</layer-list>
